@PACKAGE_INIT@

# find_package(nue 0.1 CONFIG REQUIRED)        (CMAKE_PREFIX_PATH = the folder `cmake --install` wrote)
#   target_link_libraries(game PRIVATE nue::nue)          # the engine (C API + nuepp C++ wrapper headers)
#   target_link_libraries(game PRIVATE nue::entry)        # optional: portable entry point, you define int nue_main(int, char**)
#   target_link_libraries(game PRIVATE nue::assets)       # optional: asset containers / .nuepack (separate library)
#   target_link_libraries(game PRIVATE nue::legacy)       # only when the SDK was built with the legacy ABI layer
# Variables set for the consumer: nue_SHARED (SDK is a shared library), nue_STATIC_CRT (Windows: built against the static C runtime),
# nue_HAS_SDL3 (the SDL3 backend is compiled in), nue_OS (windows|linux|android|ios|macos).
set(nue_SHARED "@NUE_CONFIG_SHARED@")
set(nue_STATIC_CRT "@NUE_CONFIG_STATIC_CRT@")
set(nue_HAS_SDL3 "@NUE_HAVE_SDL3@")
set(nue_OS "@NUE_OS@")

# A static-CRT SDK (the 32-bit launcher builds) only links with a consumer on the same C runtime: select it when the project has not chosen one.
# (Set before the consumer creates its targets; an explicit CMAKE_MSVC_RUNTIME_LIBRARY always wins.)
if(nue_STATIC_CRT AND WIN32 AND NOT DEFINED CMAKE_MSVC_RUNTIME_LIBRARY)
    set(CMAKE_MSVC_RUNTIME_LIBRARY "MultiThreaded$<$<CONFIG:Debug>:Debug>")
endif()

include(CMakeFindDependencyMacro)
if(nue_HAS_SDL3)
    find_dependency(SDL3)   # SDL3 was installed alongside the SDK (SDL3Config.cmake): static libnue links it, nue::entry needs SDL_RunApp from it
endif()
include("${CMAKE_CURRENT_LIST_DIR}/nueTargets.cmake")
check_required_components(nue)
